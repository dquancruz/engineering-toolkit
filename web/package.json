{
  "name": "engineering-toolkit-web",
  "version": "0.7.0",
  "private": true,
  "description": "Developer utilities that run entirely in the browser: JSON, format converter, regex tester and JWT decoder",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:build": "vitest run --project build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "fast-xml-parser": "^5.12.1",
    "preact": "^11.2.0",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.11",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "zod": "^4.6.7"
  }
}

{
  "name": "engineering-toolkit",
  "version": "0.4.0",
  "description": "engkit: CLI with engineering tools (docs templates, prompt builder, git helpers, Jira reports)",
  "type": "module",
  "bin": {
    "engkit": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "checklists"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "cli",
    "engineering",
    "jira",
    "adr"
  ],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dquancruz/engineering-toolkit.git"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "commander": "^15.1.0",
    "csv-parse": "^7.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
